/*
 * secrets.h  -- ALL private values live here.
 * Keep this file out of git:  echo "secrets.h" >> .gitignore
 *
 * Place it in the SAME folder as esp32_weather.ino
 */

#ifndef SECRETS_H
#define SECRETS_H

#include <pgmspace.h>

// ============================= WIFI =============================
#define WIFI_SSID     ""          // <-- phone hotspot name
#define WIFI_PASSWORD ""          // <-- hotspot password

// ========================= AWS IOT CORE =========================
// AWS Console -> IoT Core -> Settings -> "Device data endpoint"
// looks like: a1b2c3d4e5f6g7-ats.iot.ap-south-1.amazonaws.com
#define AWS_IOT_ENDPOINT ""

#define AWS_IOT_PORT 8883

// Must match the Thing name you created in AWS IoT
#define THING_NAME "esp32-weather-01"

// MQTT topics
#define AWS_PUBLISH_TOPIC   "weather/data"
#define AWS_SUBSCRIBE_TOPIC "weather/forecast"

// ========================= CERTIFICATES =========================
// Paste file contents EXACTLY, including the BEGIN/END lines.

// 1) Amazon Root CA 1   (AmazonRootCA1.pem)
static const char AWS_CERT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----

-----END CERTIFICATE-----
)EOF";

// 2) Device certificate   (xxxxxxxx-certificate.pem.crt)
static const char AWS_CERT_CRT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----

-----END CERTIFICATE-----
)EOF";

// 3) Device private key   (xxxxxxxx-private.pem.key)
static const char AWS_CERT_PRIVATE[] PROGMEM = R"EOF(
-----BEGIN RSA PRIVATE KEY-----

-----END RSA PRIVATE KEY-----
)EOF";

#endif  // SECRETS_H
